{
	"name": "@growthcat/web",
	"version": "0.0.6",
	"description": "GrowthCat Web SDK — referral codes, ads, sponsorships, attribution, and feedback for React and web apps.",
	"keywords": [
		"growthcat",
		"referral",
		"ads",
		"sponsorships",
		"attribution",
		"feedback",
		"react",
		"sdk"
	],
	"main": "./dist/index.js",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.mjs",
			"require": "./dist/index.js"
		},
		"./react": {
			"types": "./dist/react/index.d.ts",
			"import": "./dist/react/index.mjs",
			"require": "./dist/react/index.js"
		}
	},
	"files": [
		"dist"
	],
	"publishConfig": {
		"access": "public"
	},
	"sideEffects": false,
	"scripts": {
		"build": "tsup src/index.ts src/react/index.ts --format cjs,esm --dts --sourcemap --clean",
		"test": "npm run build && node --test tests/*.test.mjs",
		"dev": "tsup src/index.ts src/react/index.ts --format cjs,esm --dts --sourcemap --watch",
		"typecheck": "tsc --noEmit",
		"examples:check": "tsc -p tsconfig.examples.json",
		"lint": "eslint src",
		"check": "npm run typecheck && npm run examples:check && npm run lint && npm test"
	},
	"peerDependencies": {
		"react": ">=18.0.0",
		"react-dom": ">=18.0.0"
	},
	"peerDependenciesMeta": {
		"react": {
			"optional": true
		},
		"react-dom": {
			"optional": true
		}
	},
	"devDependencies": {
		"@eslint/js": "^9.39.5",
		"@types/react": "^18.3.31",
		"@types/react-dom": "^18.3.7",
		"@types/react-test-renderer": "^18.3.1",
		"eslint": "^9.39.5",
		"eslint-plugin-react-hooks": "^5.2.0",
		"globals": "^15.15.0",
		"react": "^18.3.1",
		"react-dom": "^18.3.1",
		"react-test-renderer": "^18.3.1",
		"tsup": "^8.0.0",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.65.0"
	},
	"license": "MIT"
}
